#pragma kernel Classify

// Root-only G1 fixture: opaque wall box [-16,-.25] x [-16,16] x [.875,1.125].
// The host permits only orthographic +Z rays originating before the wall. Cube bounds are
// axis-aligned, and strict containment leaves edge-touching candidates visible. This is a
// handoff diagnostic, not a depth pyramid or a general-purpose occlusion implementation.
StructuredBuffer<float4> Bounds;
RWStructuredBuffer<uint> Hidden;
int Count;
int WallPresent;

[numthreads(64, 1, 1)]
void Classify(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)Count) return;
    float4 b = Bounds[id];
    Hidden[id] = WallPresent && b.w > 0 &&
        b.x - b.w > -16 && b.x + b.w < -.25 &&
        b.y - b.w > -16 && b.y + b.w < 16 && b.z - b.w > 1.125 ? 1 : 0;
}
