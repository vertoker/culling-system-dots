#pragma kernel TestProjected
#pragma kernel TestWorld
struct Candidate { int2 minimum; int2 maximum; float nearest; uint valid; };
StructuredBuffer<Candidate> Candidates;
struct WorldCandidate { float3 center; uint valid; float3 extents; uint padding; };
StructuredBuffer<WorldCandidate> WorldCandidates;
RWStructuredBuffer<uint> Visible;
int2 ReferenceSize;
int LevelCount, CandidateCount;
float FarDepth, DepthBias;
float4x4 CameraView, CameraProjection;
float NearPlane, RasterYSign;
Texture2D<float> Depth0, Depth1, Depth2, Depth3, Depth4, Depth5, Depth6, Depth7;
Texture2D<float> Depth8, Depth9, Depth10, Depth11, Depth12, Depth13, Depth14, Depth15;
float LoadDepth(int level, int2 pixel)
{
    int3 location = int3(pixel, 0);
    switch (level)
    {
        case 0: return Depth0.Load(location); case 1: return Depth1.Load(location);
        case 2: return Depth2.Load(location); case 3: return Depth3.Load(location);
        case 4: return Depth4.Load(location); case 5: return Depth5.Load(location);
        case 6: return Depth6.Load(location); case 7: return Depth7.Load(location);
        case 8: return Depth8.Load(location); case 9: return Depth9.Load(location);
        case 10: return Depth10.Load(location); case 11: return Depth11.Load(location);
        case 12: return Depth12.Load(location); case 13: return Depth13.Load(location);
        case 14: return Depth14.Load(location); default: return Depth15.Load(location);
    }
}
bool Hidden(Candidate candidate)
{
    if (candidate.valid == 0 || !isfinite(candidate.nearest) || candidate.nearest <= 0 ||
        any(candidate.minimum < 0) || any(candidate.maximum > ReferenceSize) || any(candidate.maximum <= candidate.minimum)) return false;
    int extent = max(candidate.maximum.x - candidate.minimum.x, candidate.maximum.y - candidate.minimum.y);
    int level = 0;
    while (level + 1 < LevelCount && (1 << level) < extent) level++;
    int2 minimum = candidate.minimum >> level, maximum = (candidate.maximum - 1) >> level;
    // Check every overlapped cell, including both cells at a mip boundary. A coarser
    // footprint can keep extra objects visible but cannot erase an uncovered sample.
    for (int y = minimum.y; y <= maximum.y; y++)
    for (int x = minimum.x; x <= maximum.x; x++)
    {
        float depth = LoadDepth(level, int2(x,y));
        if (!isfinite(depth) || depth <= 0 || depth >= FarDepth ||
            !(candidate.nearest - depth > DepthBias * max(1, depth))) return false;
    }
    return true;
}
[numthreads(64,1,1)]
void TestProjected(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)CandidateCount) return;
    Visible[id] = Hidden(Candidates[id]) ? 0 : 1;
}
Candidate Project(WorldCandidate bounds)
{
    Candidate result = (Candidate)0;
    if (bounds.valid == 0 || !all(isfinite(bounds.center)) || !all(isfinite(bounds.extents)) || any(bounds.extents < 0)) return result;
    float2 minimum = 3.402823466e+38, maximum = -3.402823466e+38;
    float nearest = 3.402823466e+38;
    [unroll] for (uint i = 0; i < 8; i++)
    {
        float3 sign = float3((i & 1) ? 1 : -1, (i & 2) ? 1 : -1, (i & 4) ? 1 : -1);
        float4 eye = mul(CameraView, float4(bounds.center + bounds.extents * sign, 1));
        float4 clip = mul(CameraProjection, eye);
        if (!all(isfinite(eye)) || !all(isfinite(clip)) || -eye.z <= NearPlane || clip.w <= 0) return result;
        float2 uv = clip.xy / clip.w * float2(.5, .5 * RasterYSign) + .5;
        if (!all(isfinite(uv))) return result;
        minimum = min(minimum, uv); maximum = max(maximum, uv); nearest = min(nearest, -eye.z);
    }
    if (any(maximum < 0) || any(minimum > 1)) return result;
    result.minimum = max(0, (int2)floor(saturate(minimum) * ReferenceSize) - 1);
    result.maximum = min(ReferenceSize, (int2)ceil(saturate(maximum) * ReferenceSize) + 1);
    result.nearest = nearest; result.valid = all(result.maximum > result.minimum) ? 1 : 0;
    return result;
}
bool OutsideFrustum(WorldCandidate bounds)
{
    if (bounds.valid == 0 || !all(isfinite(bounds.center)) || !all(isfinite(bounds.extents)) || any(bounds.extents < 0)) return false;
    bool left = true, right = true, bottom = true, top = true, lowZ = true, highZ = true;
    [unroll] for (uint i = 0; i < 8; i++)
    {
        float3 sign = float3((i & 1) ? 1 : -1, (i & 2) ? 1 : -1, (i & 4) ? 1 : -1);
        float4 clip = mul(CameraProjection, mul(CameraView, float4(bounds.center + bounds.extents * sign, 1)));
        if (!all(isfinite(clip))) return false;
        float margin = 0.00001 * max(1, abs(clip.w));
        left = left && clip.x < -clip.w - margin; right = right && clip.x > clip.w + margin;
        bottom = bottom && clip.y < -clip.w - margin; top = top && clip.y > clip.w + margin;
        // Accepted DX12 homogeneous depth range is [0,w] in either Z direction.
        lowZ = lowZ && clip.z < -margin; highZ = highZ && clip.z > clip.w + margin;
    }
    return left || right || bottom || top || lowZ || highZ;
}
[numthreads(64,1,1)]
void TestWorld(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)CandidateCount) return;
    WorldCandidate bounds = WorldCandidates[id];
    Visible[id] = OutsideFrustum(bounds) || Hidden(Project(bounds)) ? 0 : 1;
}
