#pragma kernel ResetCounts
#pragma kernel Compact
RWByteAddressBuffer Arguments;
StructuredBuffer<uint> Visible, InputIds, GroupIds;
RWStructuredBuffer<uint> OutputIds;
uint InstanceCount, GroupCount, ArgumentStride;
[numthreads(64,1,1)] void ResetCounts(uint id:SV_DispatchThreadID)
{
    if (id>=GroupCount) return;
    Arguments.Store(id*ArgumentStride+4,0);
}
[numthreads(64,1,1)] void Compact(uint id:SV_DispatchThreadID)
{
    if (id>=InstanceCount || Visible[id]==0) return;
    uint group=GroupIds[id]; if (group>=GroupCount) return;
    uint offset=group*ArgumentStride, index;
    Arguments.InterlockedAdd(offset+4,1,index);
    uint first=Arguments.Load(offset+16);
    OutputIds[first+index]=InputIds[id];
}
